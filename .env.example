# Copy to .env for local development: cp .env.example .env
# Every value here is for local development only. Production secrets come
# from a secrets manager, never from a committed file.

# --- PostgreSQL containers (compose.yaml) ---
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments_dev_only
POSTGRES_DB=payments
TEST_POSTGRES_USER=payments_test
TEST_POSTGRES_PASSWORD=payments_test_only
TEST_POSTGRES_DB=payments_test
# Host ports for tools on your machine; services use the Compose network.
# Change these if another local PostgreSQL already uses them.
DB_HOST_PORT=5432
TEST_DB_HOST_PORT=5433
# The dashboard, API and worker on your machine (docker compose up). A different
# web port must also be named in ALLOWED_ORIGINS.
WEB_HOST_PORT=5173
API_HOST_PORT=3000
WORKER_HOST_PORT=3001

# --- Database connections (host names are Compose service names) ---
DATABASE_URL=postgres://payments:payments_dev_only@db:5432/payments
TEST_DATABASE_URL=postgres://payments_test:payments_test_only@test-db:5432/payments_test

# --- Ports ---
API_PORT=3000
WORKER_HEALTH_PORT=3001

# --- Authentication ---
# Generate real secrets with: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
JWT_ISSUER=payment-platform
JWT_AUDIENCE=payment-platform-api
SESSION_TTL_SECONDS=28800
CSRF_SECRET=dev-only-csrf-secret-change-me-0123456789abcdef
CURSOR_SECRET=dev-only-cursor-secret-change-me-0123456789abcdef
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# --- Login throttling ---
LOGIN_THROTTLE_WINDOW_SECONDS=900
LOGIN_THROTTLE_MAX_PER_EMAIL=5
LOGIN_THROTTLE_MAX_PER_IP=50

# --- Provider and settlement ---
PROVIDER_TIMEOUT_MS=5000
SETTLEMENT_DELAY_MS=10000

# --- Worker and jobs ---
WORKER_POLL_INTERVAL_MS=5000
WORKER_CONCURRENCY=1
JOB_LEASE_SECONDS=30
JOB_MAX_RETRIES=3
JOB_RETRY_BASE_MS=2000
REVIEW_DEADLINE_SECONDS=1800
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_SHUTDOWN_GRACE_MS=15000

# --- Logging ---
LOG_LEVEL=info
